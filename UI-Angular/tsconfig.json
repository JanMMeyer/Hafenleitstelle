/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
	"compileOnSave": false,
	"compilerOptions": {
		"strict": true,
		"alwaysStrict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "preserve",
		"paths": {
			"@cockpit/app/*": ["./projects/hafen-cockpit/src/app/*"],
			"@cockpit/shared/*": ["./projects/hafen-cockpit/src/app/shared/*"],
			"@cockpit/feature/*": ["./projects/hafen-cockpit/src/app/feature/*"],
			"@cockpit/core/*": ["./projects/hafen-cockpit/src/app/core/*"]
		}
	},
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": true,
		"strictInputAccessModifiers": true,
		"strictTemplates": true
	},
	"files": [],
	"references": [
		{
			"path": "./projects/hafen-cockpit/tsconfig.app.json"
		},
		{
			"path": "./projects/hafen-cockpit/tsconfig.spec.json"
		}
	]
}
